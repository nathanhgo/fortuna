# Config compartilhada por todos os serviços (backend, frontend, docker-compose).
# Copie para `.env` na raiz do repositório — não é por serviço, é um só (ver
# architecture_docs/stack.md). Nunca commitar o `.env` real (já está no .gitignore).

# --- Django (backend) ---
DJANGO_SECRET_KEY=change-me-in-every-environment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Ativa o debugpy no container do backend, escutando em 0.0.0.0:5678 (ver .vscode/launch.json).
DJANGO_DEBUGPY=0

# --- Postgres ---
# POSTGRES_HOST=localhost é o valor certo se você rodar o backend fora do Docker (venv local).
# O docker-compose.yml sobrescreve isso para "postgres" automaticamente para o container do
# backend — não precisa editar nada aqui por causa do Docker.
POSTGRES_DB=fortuna
POSTGRES_USER=fortuna
POSTGRES_PASSWORD=fortuna
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- CORS (backend) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Produção (Vercel + Render): acrescente https://seu-app.vercel.app
# CSRF_TRUSTED_ORIGINS=https://seu-app.vercel.app,https://seu-backend.onrender.com
# CORS_ALLOWED_ORIGIN_REGEXES=https://.*\\.vercel\\.app

# Neon (produção): uma URL no lugar das variáveis POSTGRES_* acima.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# --- Next.js (frontend) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# URL canônica do site (sitemap, Open Graph, robots). Em produção, o domínio real.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Ativa o inspector do Node no container do frontend, escutando em 0.0.0.0:9229.
NODE_DEBUGGER=0
